{$DOMAIN} {
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle /ws {
        reverse_proxy backend:8080
    }
    handle {
        root * /srv
        @bukanAset not path /assets/*
        header @bukanAset Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

